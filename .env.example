# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Application ID of the bot.
DISCORD_CLIENT_ID=

# Server where the role lives. Commands are registered here so they show up immediately.
DISCORD_GUILD_ID=

# Role granted after both checks pass. The bot's own role must be higher than this one.
VERIFIED_ROLE_ID=

# How often linked miners are rechecked. Role is removed only when every pool answers
# and none of them still show fresh DATUM shares.
SCAN_INTERVAL_HOURS=24

# A share counts as fresh when the pool's last-share time is inside this window.
# Pools that only publish a hashrate count a positive hashrate as fresh.
SHARE_MAX_AGE_HOURS=24

# CONVOY's public worker table does not print a DATUM flag. Its published setup path
# is a DATUM Gateway, so an active worker is treated as DATUM. Set to false to ignore it.
CONVOY_TREAT_ACTIVE_AS_DATUM=true

DATABASE_PATH=./data/bot.sqlite
