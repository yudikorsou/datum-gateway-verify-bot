# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric id of the community. Add the bot, then send /chatid in that chat.
# Supergroup ids look like -1001234567890.
TELEGRAM_CHAT_ID=

# How often linked miners are rechecked. Access is removed only when every pool
# answers and none of them still show fresh DATUM shares.
SCAN_INTERVAL_HOURS=24

# A share counts as fresh when the pool's last-share time is inside this window.
# Pools that only publish a hashrate count a positive hashrate as fresh.
SHARE_MAX_AGE_HOURS=24

# CONVOY's public worker table does not print a DATUM flag. Its published setup path
# is a DATUM Gateway, so an active worker is treated as DATUM. Set to false to ignore it.
CONVOY_TREAT_ACTIVE_AS_DATUM=true

DATABASE_PATH=./data/bot.sqlite
